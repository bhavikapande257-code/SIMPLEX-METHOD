# MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    coefficients, signs, rhs, choice = get_input()

    obj         = coefficients[0]
    constraints = coefficients[1:]
    num_vars    = len(obj)
    num_cons    = len(rhs)

    needs_artificial = any(s in (">=", "=") for s in signs)

    if needs_artificial:
        print("\n  This problem has >= or = constraints and requires artificial variables.")
        print("  Choose solution method:")
        print("    1.  Big-M Method")
        print("    2.  Two-Phase Method")
        m = input("  Enter 1 or 2 : ").strip()
        while m not in ("1", "2"):
            m = input("  Please enter 1 or 2 : ").strip()
        if m == "1":
            run_bigM(obj, constraints, signs, rhs, choice, num_vars, num_cons)
        else:
            run_two_phase(obj, constraints, signs, rhs, choice, num_vars, num_cons)
    else:
        run_standard(obj, constraints, signs, rhs, choice, num_vars, num_cons)


if __name__ == "__main__":
    main()
