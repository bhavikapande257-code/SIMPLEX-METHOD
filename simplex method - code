"""
SIMPLEX METHOD STEP-BY-STEP TUTOR
Supports:
  - Standard (<= only)         : simple slack-variable simplex
  - Mixed / equality constraints: Big-M method OR Two-Phase method (user chooses)
Special case detection:
  - Alternate (multiple) optimal solutions
  - Unbounded problem
  - Infeasible problem
  - Degenerate solution
"""

BIG_M   = 1_000_000
EPSILON = 1e-9


# ─────────────────────────────────────────────────────────────────────────────
# INPUT
# ─────────────────────────────────────────────────────────────────────────────

def get_input():
    print("=" * 65)
    print("         SIMPLEX METHOD STEP-BY-STEP TUTOR")
    print("=" * 65)

    choice = input("\nMaximization or Minimization? (max/min): ").strip().lower()
    while choice not in ("max", "min"):
        choice = input("  Please enter 'max' or 'min': ").strip().lower()

    num_variables   = int(input("Enter number of decision variables : "))
    num_constraints = int(input("Enter number of constraints        : "))

    coefficients, signs, rhs = [], [], []

    print("\nEnter objective function coefficients (space-separated):")
    obj_input = input("  e.g. 5x1 + 4x2  -->  5 4 : ").split()
    coefficients.append([float(x) for x in obj_input])

    print("\nEnter each constraint:")
    for i in range(num_constraints):
        print(f"\n  Constraint {i + 1}:")
        con_input = input("    Coefficients (space-separated): ").split()
        coefficients.append([float(x) for x in con_input])
        sign = input("    Sign  (<=  /  >=  /  =) : ").strip()
        while sign not in ("<=", ">=", "="):
            sign = input("    Please enter <=, >= or = : ").strip()
        signs.append(sign)
        rhs_val = float(input("    RHS value               : "))
        rhs.append(rhs_val)

    return coefficients, signs, rhs, choice


# ─────────────────────────────────────────────────────────────────────────────
# HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def fmt(val):
    if abs(val) >= BIG_M / 2:
        return "M" if val > 0 else "-M"
    r = round(val, 4)
    return str(int(r)) if r == int(r) else f"{r:.3f}"


def sep(n=65):
    print("-" * n)


# ─────────────────────────────────────────────────────────────────────────────
# TABLEAU PRINTER
# ─────────────────────────────────────────────────────────────────────────────

def print_tableau(tableau, basics, col_names, pivot_col=-1, pivot_row=-1):
    """
    Pivot element  : [val]
    Pivot column   : (val)
    Pivot row      : val*
    """
    cw = 10
    print(f"{'BV':>{cw}}", end="")
    for n in col_names:
        print(f"{n:>{cw}}", end="")
    print()
    print("-" * cw * (len(col_names) + 1))

    for ri, row in enumerate(tableau):
        bv = "Z" if ri == 0 else col_names[basics[ri - 1]]
        print(f"{bv:>{cw}}", end="")

        for ci, val in enumerate(row):
            cell = fmt(val)
            if ri == pivot_row and ci == pivot_col:
                cell = f"[{cell}]"
            elif ci == pivot_col and ri != 0 and ri != pivot_row:
                cell = f"({cell})"
            elif ri == pivot_row and ci != pivot_col:
                cell = f"{cell}*"
            print(f"{cell:>{cw}}", end="")
        print()
    print()


# ─────────────────────────────────────────────────────────────────────────────
# SIMPLEX CORE OPERATIONS
# ─────────────────────────────────────────────────────────────────────────────

def find_pivot_col(z_row):
    most_neg, idx = -EPSILON, -1
    for j in range(len(z_row) - 1):
        if z_row[j] < most_neg:
            most_neg, idx = z_row[j], j
    return idx


def find_pivot_row(tableau, pivot_col):
    ratios = []
    for i in range(1, len(tableau)):
        val = tableau[i][pivot_col]
        rhs = tableau[i][-1]
        ratios.append((rhs / val if val > EPSILON else float("inf"), i))
    if all(r == float("inf") for r, _ in ratios):
        return -1, ratios
    min_ratio, min_row = min(ratios, key=lambda x: x[0])
    return min_row, ratios


def do_pivot(tableau, pivot_row, pivot_col):
    t  = [row[:] for row in tableau]
    pv = t[pivot_row][pivot_col]
    t[pivot_row] = [v / pv for v in t[pivot_row]]
    for i in range(len(t)):
        if i != pivot_row:
            f = t[i][pivot_col]
            t[i] = [t[i][j] - f * t[pivot_row][j] for j in range(len(t[i]))]
    return t


# ─────────────────────────────────────────────────────────────────────────────
# SPECIAL-CASE DETECTION
# ─────────────────────────────────────────────────────────────────────────────

def detect_special_cases(tableau, basics, col_names, num_vars):
    """
    Called when the Z-row is fully non-negative (optimal tableau reached).
    Returns a list of human-readable strings for each detected special case.
    """
    cases = []
    n_rows = len(tableau)

    # ── 1. DEGENERATE ────────────────────────────────────────────────────────
    # A basic feasible solution is degenerate if any basic variable equals 0.
    for i in range(1, n_rows):
        if abs(tableau[i][-1]) < EPSILON:
            cases.append(
                f"DEGENERATE SOLUTION — basic variable "
                f"{col_names[basics[i - 1]]} = 0 in row {i}. "
                f"The BFS is degenerate; the simplex method may cycle."
            )

    # ── 2. ALTERNATE OPTIMAL ─────────────────────────────────────────────────
    # A non-basic decision variable has a zero Z-row coefficient at optimality.
    basic_set = set(basics)
    for j in range(num_vars):
        if j not in basic_set and abs(tableau[0][j]) < EPSILON:
            cases.append(
                f"ALTERNATE OPTIMAL SOLUTION — non-basic variable "
                f"{col_names[j]} has zero Z-row coefficient. "
                f"Pivoting on {col_names[j]} yields another optimal BFS "
                f"with the same Z* value. Infinitely many optimal solutions exist."
            )

    # ── 3. INFEASIBLE (Big-M) ────────────────────────────────────────────────
    # An artificial variable remains basic with a positive value.
    for i in range(1, n_rows):
        bv = col_names[basics[i - 1]]
        if bv.startswith("a") and tableau[i][-1] > EPSILON:
            cases.append(
                f"INFEASIBLE — artificial variable {bv} is still in the basis "
                f"with value {fmt(tableau[i][-1])} > 0. "
                f"The original constraints are contradictory; no feasible solution exists."
            )

    return cases


# ─────────────────────────────────────────────────────────────────────────────
# EXPLANATION PRINTER
# ─────────────────────────────────────────────────────────────────────────────

def print_explanation(phase, tableau, basics, col_names,
                      pivot_col=-1, pivot_row=-1, ratios=None,
                      iteration=0, choice="max", num_vars=2,
                      method="", special_cases=None):
    sep()

    if phase == "initial":
        neg = [(col_names[j], fmt(tableau[0][j]))
               for j in range(len(tableau[0]) - 1)
               if tableau[0][j] < -EPSILON]
        print(f"STEP 0 — Initial Tableau  [{method}]")
        sep()
        slack_names = [col_names[i] for i in range(num_vars, len(col_names) - 1)
                       if col_names[i].startswith("s")]
        art_names   = [col_names[i] for i in range(num_vars, len(col_names) - 1)
                       if col_names[i].startswith("a")]
        if slack_names:
            print(f"  Slack/surplus variables added : {', '.join(slack_names)}")
        if art_names:
            print(f"  Artificial variables added    : {', '.join(art_names)}")
            if method == "Big-M":
                print(f"  Each artificial penalised with M = {BIG_M:,} in Z-row.")
            elif method == "Phase 1":
                print(f"  Phase 1 objective: minimise w = sum of artificial variables.")
        print(f"  Starting Z = {fmt(tableau[0][-1])}")
        if neg:
            print(f"  Negative Z-row coefficients: "
                  + ", ".join(f"{n}({v})" for n, v in neg))
        print(f"\n  NEXT: Select the most negative Z-row coefficient "
              f"as the entering variable (largest improvement to Z).")

    elif phase == "pivot":
        entering = col_names[pivot_col]
        leaving  = col_names[basics[pivot_row - 1]]
        pv       = fmt(tableau[pivot_row][pivot_col])
        z_coef   = fmt(tableau[0][pivot_col])
        neg      = [(col_names[j], fmt(tableau[0][j]))
                    for j in range(len(tableau[0]) - 1)
                    if tableau[0][j] < -EPSILON]

        print(f"ITERATION {iteration} — Pivot Step  [{method}]")
        sep()
        print(f"  Negative Z-row: " + ", ".join(f"{n}({v})" for n, v in neg))

        print(f"\n  ENTERING VARIABLE : {entering}")
        print(f"    Most negative Z-row coefficient = {z_coef}.")
        print(f"    Bringing {entering} into the basis improves Z the most.")

        print(f"\n  MINIMUM RATIO TEST  (RHS / pivot-column value):")
        min_r = min(r for r, _ in ratios if r != float("inf"))
        for ratio_val, row_idx in ratios:
            bv      = col_names[basics[row_idx - 1]]
            col_val = fmt(tableau[row_idx][pivot_col])
            rhs_val = fmt(tableau[row_idx][-1])
            if ratio_val == float("inf"):
                print(f"    Row {bv:<5}: {rhs_val} / {col_val} = N/A  (skip)")
            else:
                marker = "  <-- MINIMUM (leaving)" if abs(ratio_val - min_r) < EPSILON else ""
                print(f"    Row {bv:<5}: {rhs_val} / {col_val} = {fmt(ratio_val)}{marker}")

        print(f"\n  LEAVING VARIABLE  : {leaving}")
        print(f"    Smallest non-negative ratio = {fmt(min_r)}")
        print(f"\n  PIVOT ELEMENT     : [{pv}]  (row {leaving}, col {entering})")
        print(f"    Step 1 — Divide row {leaving} by {pv}")
        print(f"    Step 2 — Eliminate {entering} from all other rows")
        print(f"\n  NEXT: {entering} enters the basis, {leaving} leaves.")

        if abs(min_r) < EPSILON:
            print(f"\n  *** DEGENERATE PIVOT — ratio = 0. "
                  f"Z will not change this iteration.")

    elif phase == "optimal":
        z_val = abs(round(tableau[0][-1], 6))
        sol   = []
        for i in range(num_vars):
            br  = basics.index(i) if i in basics else -1
            val = tableau[br + 1][-1] if br >= 0 else 0.0
            sol.append(f"{col_names[i]} = {fmt(val)}")
        print("OPTIMAL SOLUTION FOUND")
        sep()
        print("  All Z-row coefficients >= 0.  No further improvement possible.")
        print(f"\n  Optimal Z* = {fmt(z_val)}")
        print(f"  Solution  : {',  '.join(sol)}")
        if special_cases:
            print()
            for sc in special_cases:
                print(f"  *** {sc}")

    elif phase == "unbounded":
        entering = col_names[pivot_col]
        print("PROBLEM IS UNBOUNDED")
        sep()
        print(f"  Entering variable {entering} has no positive column coefficients.")
        print(f"  Ratio test cannot select a leaving variable.")
        print(f"  Z can grow without bound — no finite optimal solution exists.")

    elif phase == "infeasible":
        print("PROBLEM IS INFEASIBLE")
        sep()
        print("  The Phase 1 objective w > 0 at termination.")
        print("  The constraints cannot all be satisfied simultaneously.")
        print("  No feasible solution exists for this problem.")

    elif phase == "phase2_start":
        print("PHASE 1 COMPLETE — Starting Phase 2")
        sep()
        print("  All artificial variables are 0 (or removed from basis).")
        print("  A basic feasible solution to the original problem was found.")
        print("  Phase 2: now optimise the original objective Z.")

    sep()


# ─────────────────────────────────────────────────────────────────────────────
# BIG-M METHOD
# ─────────────────────────────────────────────────────────────────────────────

def build_bigM_tableau(obj, constraints, signs, rhs, choice, num_vars, num_cons):
    direction  = -1 if choice == "max" else 1
    extra_names, slack_map, art_cols = [], {}, []

    base = num_vars
    for i, s in enumerate(signs):
        if s == "<=":
            extra_names.append(f"s{i+1}")
            slack_map[i] = (base, "slack");   base += 1
        elif s == ">=":
            extra_names.append(f"s{i+1}")
            slack_map[i] = (base, "surplus"); base += 1
            extra_names.append(f"a{i+1}")
            art_cols.append((i, base));       base += 1
        elif s == "=":
            extra_names.append(f"a{i+1}")
            art_cols.append((i, base));       base += 1

    total_cols = base + 1
    col_names  = [f"x{i+1}" for i in range(num_vars)] + extra_names + ["RHS"]

    z_row = [direction * c for c in obj] + [0.0] * len(extra_names) + [0.0]
    for _, col_idx in art_cols:
        z_row[col_idx] = BIG_M

    tableau, basics = [z_row], []
    for i in range(num_cons):
        row = list(constraints[i]) + [0.0] * len(extra_names) + [rhs[i]]
        if i in slack_map:
            col_idx, kind = slack_map[i]
            row[col_idx] = 1.0 if kind == "slack" else -1.0
        for ci, col_idx in art_cols:
            if ci == i:
                row[col_idx] = 1.0
        bv = (slack_map[i][0] if (i in slack_map and slack_map[i][1] == "slack")
              else next(c for (ci, c) in art_cols if ci == i))
        basics.append(bv)
        tableau.append(row)

    # eliminate artificials from Z row
    for ci, col_idx in art_cols:
        factor = z_row[col_idx]
        for j in range(total_cols):
            z_row[j] -= factor * tableau[ci + 1][j]
    tableau[0] = z_row

    return tableau, basics, col_names


def run_bigM(obj, constraints, signs, rhs, choice, num_vars, num_cons):
    tableau, basics, col_names = build_bigM_tableau(
        obj, constraints, signs, rhs, choice, num_vars, num_cons)

    print("\n" + "=" * 65)
    print_explanation("initial", tableau, basics, col_names,
                      num_vars=num_vars, method="Big-M")
    print()
    print_tableau(tableau, basics, col_names)
    input("  Press ENTER for next step...")

    for iteration in range(1, 100):
        pc = find_pivot_col(tableau[0])
        if pc == -1:
            sc = detect_special_cases(tableau, basics, col_names, num_vars)
            infeasible = any("INFEASIBLE" in s for s in sc)
            print("\n" + "=" * 65)
            if infeasible:
                print_explanation("infeasible", tableau, basics, col_names)
            else:
                print_explanation("optimal", tableau, basics, col_names,
                                  num_vars=num_vars, choice=choice,
                                  special_cases=sc)
            print()
            print_tableau(tableau, basics, col_names)
            return

        pr, ratios = find_pivot_row(tableau, pc)
        if pr == -1:
            print("\n" + "=" * 65)
            print_explanation("unbounded", tableau, basics, col_names,
                              pivot_col=pc)
            return

        print("\n" + "=" * 65)
        print_explanation("pivot", tableau, basics, col_names,
                          pivot_col=pc, pivot_row=pr, ratios=ratios,
                          iteration=iteration, choice=choice,
                          num_vars=num_vars, method="Big-M")
        print()
        print("  Tableau BEFORE  ( [ ] = pivot element | ( ) = pivot col | * = pivot row )")
        print()
        print_tableau(tableau, basics, col_names, pivot_col=pc, pivot_row=pr)
        tableau = do_pivot(tableau, pr, pc)
        basics[pr - 1] = pc
        print("  Tableau AFTER pivot:")
        print()
        print_tableau(tableau, basics, col_names)
        input("  Press ENTER for next step...")


# ─────────────────────────────────────────────────────────────────────────────
# TWO-PHASE METHOD
# ─────────────────────────────────────────────────────────────────────────────

def build_phase1_tableau(obj, constraints, signs, rhs, num_vars, num_cons):
    extra_names, slack_map, art_cols = [], {}, []

    base = num_vars
    for i, s in enumerate(signs):
        if s == "<=":
            extra_names.append(f"s{i+1}")
            slack_map[i] = (base, "slack");   base += 1
        elif s == ">=":
            extra_names.append(f"s{i+1}")
            slack_map[i] = (base, "surplus"); base += 1
            extra_names.append(f"a{i+1}")
            art_cols.append((i, base));       base += 1
        elif s == "=":
            extra_names.append(f"a{i+1}")
            art_cols.append((i, base));       base += 1

    total_cols = base + 1
    col_names  = [f"x{i+1}" for i in range(num_vars)] + extra_names + ["RHS"]

    z_row = [0.0] * total_cols
    for _, col_idx in art_cols:
        z_row[col_idx] = 1.0   # minimise sum of artificials

    tableau, basics = [z_row], []
    for i in range(num_cons):
        row = list(constraints[i]) + [0.0] * len(extra_names) + [rhs[i]]
        if i in slack_map:
            col_idx, kind = slack_map[i]
            row[col_idx] = 1.0 if kind == "slack" else -1.0
        for ci, col_idx in art_cols:
            if ci == i:
                row[col_idx] = 1.0
        bv = (slack_map[i][0] if (i in slack_map and slack_map[i][1] == "slack")
              else next(c for (ci, c) in art_cols if ci == i))
        basics.append(bv)
        tableau.append(row)

    # eliminate artificials from w row
    for ci, col_idx in art_cols:
        factor = z_row[col_idx]
        for j in range(total_cols):
            z_row[j] -= factor * tableau[ci + 1][j]
    tableau[0] = z_row

    return tableau, basics, col_names, art_cols


def build_phase2_tableau(tab_p1, basics_p1, col_names_p1, obj, choice, num_vars, art_cols):
    art_idx  = {col_idx for _, col_idx in art_cols}
    keep     = [j for j in range(len(col_names_p1)) if j not in art_idx]
    new_names = [col_names_p1[j] for j in keep]
    new_tab   = [[row[j] for j in keep] for row in tab_p1]

    direction = -1 if choice == "max" else 1
    z_row = [0.0] * len(new_names)
    for i, c in enumerate(obj):
        z_row[i] = direction * c

    old_to_new = {old: new for new, old in enumerate(keep)}
    new_basics  = [old_to_new[b] for b in basics_p1]

    # eliminate basic variables from Z row
    for i, bv in enumerate(new_basics):
        f = z_row[bv]
        if abs(f) > EPSILON:
            for j in range(len(z_row)):
                z_row[j] -= f * new_tab[i + 1][j]

    new_tab[0] = z_row
    return new_tab, new_basics, new_names


def run_two_phase(obj, constraints, signs, rhs, choice, num_vars, num_cons):

    # ── PHASE 1 ──────────────────────────────────────────────────────────────
    tableau, basics, col_names, art_cols = build_phase1_tableau(
        obj, constraints, signs, rhs, num_vars, num_cons)

    print("\n" + "=" * 65)
    print("  PHASE 1  —  Minimise w = sum of artificial variables")
    print("=" * 65)
    print_explanation("initial", tableau, basics, col_names,
                      num_vars=num_vars, method="Phase 1")
    print()
    print_tableau(tableau, basics, col_names)
    input("  Press ENTER for next step...")

    for iteration in range(1, 100):
        pc = find_pivot_col(tableau[0])
        if pc == -1:
            w_val = tableau[0][-1]
            if w_val > EPSILON:
                print("\n" + "=" * 65)
                print_explanation("infeasible", tableau, basics, col_names)
                print_tableau(tableau, basics, col_names)
                return
            break   # Phase 1 optimal and feasible

        pr, ratios = find_pivot_row(tableau, pc)
        if pr == -1:
            print("\n" + "=" * 65)
            print_explanation("unbounded", tableau, basics, col_names, pivot_col=pc)
            return

        print("\n" + "=" * 65)
        print_explanation("pivot", tableau, basics, col_names,
                          pivot_col=pc, pivot_row=pr, ratios=ratios,
                          iteration=iteration, num_vars=num_vars, method="Phase 1")
        print()
        print("  Tableau BEFORE  ( [ ] = pivot element | ( ) = pivot col | * = pivot row )")
        print()
        print_tableau(tableau, basics, col_names, pivot_col=pc, pivot_row=pr)
        tableau = do_pivot(tableau, pr, pc)
        basics[pr - 1] = pc
        print("  Tableau AFTER pivot:")
        print()
        print_tableau(tableau, basics, col_names)
        input("  Press ENTER for next step...")

    # ── PHASE 2 ──────────────────────────────────────────────────────────────
    tableau, basics, col_names = build_phase2_tableau(
        tableau, basics, col_names, obj, choice, num_vars, art_cols)

    print("\n" + "=" * 65)
    print_explanation("phase2_start", tableau, basics, col_names)
    print()
    print("  PHASE 2  —  Optimise original objective Z")
    print("=" * 65)
    print_tableau(tableau, basics, col_names)
    input("  Press ENTER to begin Phase 2...")

    for iteration in range(1, 100):
        pc = find_pivot_col(tableau[0])
        if pc == -1:
            sc = detect_special_cases(tableau, basics, col_names, num_vars)
            print("\n" + "=" * 65)
            print_explanation("optimal", tableau, basics, col_names,
                              num_vars=num_vars, choice=choice, special_cases=sc)
            print()
            print_tableau(tableau, basics, col_names)
            return

        pr, ratios = find_pivot_row(tableau, pc)
        if pr == -1:
            print("\n" + "=" * 65)
            print_explanation("unbounded", tableau, basics, col_names, pivot_col=pc)
            return

        print("\n" + "=" * 65)
        print_explanation("pivot", tableau, basics, col_names,
                          pivot_col=pc, pivot_row=pr, ratios=ratios,
                          iteration=iteration, choice=choice,
                          num_vars=num_vars, method="Phase 2")
        print()
        print("  Tableau BEFORE  ( [ ] = pivot element | ( ) = pivot col | * = pivot row )")
        print()
        print_tableau(tableau, basics, col_names, pivot_col=pc, pivot_row=pr)
        tableau = do_pivot(tableau, pr, pc)
        basics[pr - 1] = pc
        print("  Tableau AFTER pivot:")
        print()
        print_tableau(tableau, basics, col_names)
        input("  Press ENTER for next step...")


# ─────────────────────────────────────────────────────────────────────────────
# STANDARD SIMPLEX  (all-<= problems, no artificials)
# ─────────────────────────────────────────────────────────────────────────────

def build_standard_tableau(obj, constraints, signs, rhs, choice, num_vars, num_cons):
    direction = -1 if choice == "max" else 1
    col_names = ([f"x{i+1}" for i in range(num_vars)]
                 + [f"s{i+1}" for i in range(num_cons)]
                 + ["RHS"])
    z_row   = [direction * c for c in obj] + [0.0] * num_cons + [0.0]
    tableau = [z_row]
    for i in range(num_cons):
        row = list(constraints[i])
        for j in range(num_cons):
            row.append(1.0 if i == j else 0.0)
        row.append(float(rhs[i]))
        tableau.append(row)
    basics = [num_vars + i for i in range(num_cons)]
    return tableau, basics, col_names


def run_standard(obj, constraints, signs, rhs, choice, num_vars, num_cons):
    tableau, basics, col_names = build_standard_tableau(
        obj, constraints, signs, rhs, choice, num_vars, num_cons)

    print("\n" + "=" * 65)
    print_explanation("initial", tableau, basics, col_names,
                      num_vars=num_vars, method="Standard Simplex")
    print()
    print_tableau(tableau, basics, col_names)
    input("  Press ENTER for next step...")

    for iteration in range(1, 100):
        pc = find_pivot_col(tableau[0])
        if pc == -1:
            sc = detect_special_cases(tableau, basics, col_names, num_vars)
            print("\n" + "=" * 65)
            print_explanation("optimal", tableau, basics, col_names,
                              num_vars=num_vars, choice=choice, special_cases=sc)
            print()
            print_tableau(tableau, basics, col_names)
            return

        pr, ratios = find_pivot_row(tableau, pc)
        if pr == -1:
            print("\n" + "=" * 65)
            print_explanation("unbounded", tableau, basics, col_names, pivot_col=pc)
            return

        print("\n" + "=" * 65)
        print_explanation("pivot", tableau, basics, col_names,
                          pivot_col=pc, pivot_row=pr, ratios=ratios,
                          iteration=iteration, choice=choice,
                          num_vars=num_vars, method="Standard")
        print()
        print("  Tableau BEFORE  ( [ ] = pivot element | ( ) = pivot col | * = pivot row )")
        print()
        print_tableau(tableau, basics, col_names, pivot_col=pc, pivot_row=pr)
        tableau = do_pivot(tableau, pr, pc)
        basics[pr - 1] = pc
        print("  Tableau AFTER pivot:")
        print()
        print_tableau(tableau, basics, col_names)
        input("  Press ENTER for next step...")


